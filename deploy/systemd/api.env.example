# CryptoMon API environment. Install to /etc/cryptomon/api.env, mode 0600,
# owned root:root.
#
#     install -D -m0600 -o root -g root \
#         deploy/systemd/api.env.example /etc/cryptomon/api.env
#
# root:root and not the service account: systemd reads this file as PID 1,
# before it drops to User=cryptomon, so the service never needs to be able to
# open it. Something that compromises the service gets the environment it
# produced, not the file.
#
# This file is not in the repository as api.env, and must not be added to it.
# Keep the .example suffix on the copy you commit.
#
# Syntax is systemd's, not the shell's: VAR=value, no `export`, no command
# substitution, and quotes are only needed around a value with spaces.

# --------------------------------------------------------------------------
# Database -- required, no default
# --------------------------------------------------------------------------
# Put the real password here. It is why this file is 0600.
DB_URL=mongodb://cryptomonUser:CHANGE-ME@127.0.0.1:27017/cryptomon?retryWrites=true&w=majority
DB_NAME=cryptomon

# --------------------------------------------------------------------------
# The reverse proxy
# --------------------------------------------------------------------------
# MUST equal the `location` prefix in deploy/nginx/cryptomon.conf, without a
# trailing slash. Empty means the service is at the domain root.
#
# These two values are the only pair in this deployment that have to agree
# with each other, and the nginx config is arranged so that disagreement
# gives a 404 on the first page rather than a site whose links are quietly
# one level out. See the long comment at the top of cryptomon.conf.
# Leave this EMPTY unless a reverse proxy really is mounting the
# service under a subpath. create-service.sh installs this file
# verbatim while --nginx is opt-in, so a value here reaches a
# service that nothing is proxying: /docs then fetches
# /cryptomon/openapi.json and 404s, and the redirect after an
# upload points at /cryptomon/analyse/reports/<id>, also a 404.
# Uncomment it at the same moment you put the nginx config in place.
#ROOT_PATH=/cryptomon

# Which addresses uvicorn will believe X-Forwarded-For and X-Forwarded-Proto
# from. 127.0.0.1 is uvicorn's own default and is right when nginx is on this
# host. If nginx is elsewhere, put its address here -- otherwise every
# forwarded header is discarded with no warning, every client appears to be
# the proxy, and the redirect after an upload comes back as http:// on an
# https site.
#
# Do not set this to "*" on a host where anything else can reach port 8000:
# it means any client can claim any source address and any scheme.
FORWARDED_ALLOW_IPS=127.0.0.1

# Loopback, so that nginx is the only way in. Changing this to 0.0.0.0
# publishes the API on every interface and makes every protection in the
# nginx config irrelevant, because clients can go around it.
HOST=127.0.0.1
PORT=8000

# --------------------------------------------------------------------------
# Access control
# --------------------------------------------------------------------------
# Writes to /data/ are refused unless this is false. Leave it true unless
# something genuinely needs to POST records over HTTP; the sensor writes to
# MongoDB directly and does not use this API.
READ_ONLY=true

# When set, mutating routes and the upload route require an X-API-Key header.
# Set it. This deployment is reachable from somewhere other than localhost --
# that is what the nginx config in front of it is for -- and an open upload
# endpoint is an open invitation to spend your CPU and your disk.
#
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Note the consequence for the browser UI: fapi/app/templates/upload.html
# cannot set a header, so with API_KEY set the form says so and uploads have
# to come from curl. Decide which you want.
API_KEY=

# --------------------------------------------------------------------------
# Uploads
# --------------------------------------------------------------------------
UPLOADS_ENABLED=true

# NOT the /tmp default. cryptomon-api.service sets PrivateTmp=yes, which puts
# /tmp in a namespace destroyed when the service stops -- so reports in
# /tmp/cryptomon-uploads would vanish on every restart while the form went on
# promising they were kept for REPORT_RETENTION_HOURS. This path is created
# by StateDirectory= in the unit, 0700 and owned by the service account.
UPLOAD_DIR=/var/lib/cryptomon/uploads

# 256 MiB. KEEP IN STEP with client_max_body_size in the nginx config, which
# must be strictly larger -- raise one and you must raise the other, or nginx
# starts refusing uploads with its own unstyled 413 before the application's
# message can be shown. tests/test_deployment.py checks the pair.
MAX_UPLOAD_BYTES=268435456

# Wall-clock ceiling for one analysis. KEEP IN STEP with proxy_read_timeout,
# which must exceed it, or nginx answers 504 for work the service finished.
ANALYSIS_TIMEOUT_SECONDS=120

# --------------------------------------------------------------------------
# Retention
# --------------------------------------------------------------------------
# A report holds SNI, which is browsing history.
REPORT_RETENTION_HOURS=24
RETENTION_SWEEP_MINUTES=15

# The live collection. 0 keeps everything, which is the default and is
# deliberate: silently discarding a monitoring database destroys the
# historical series this project exists to build.
DATA_RETENTION_HOURS=0

# --------------------------------------------------------------------------
# Never set DEBUG_MODE=true here
# --------------------------------------------------------------------------
# api.py passes it to uvicorn as `reload=`, which starts a file watcher and
# reloads the process on change. On a service that is fine locally and is
# not what you want on a host exposed through nginx.
DEBUG_MODE=false
