# CryptoMon sensor environment. Install to /etc/cryptomon/sensor.env, mode
# 0600, owned root:root.
#
#     install -D -m0600 -o root -g root \
#         deploy/systemd/sensor.env.example /etc/cryptomon/sensor.env
#
# Separate from api.env on purpose. This process runs with CAP_BPF and
# CAP_NET_ADMIN; it needs the database credential and nothing else. API_KEY
# does not belong in a file read by the most privileged process on the host.

# --------------------------------------------------------------------------
# Required. The service will not start without it.
# --------------------------------------------------------------------------
# The interface to attach the eBPF program to. There is no default and no
# sensible guess.
#
# If this is unset or empty, cryptomon.py's parse_argz() falls back to
# prompting with input(). Under systemd there is no terminal, so that raises
# EOFError and the unit dies on every start -- with a traceback that says
# nothing about a missing interface. `ip -br link` will tell you the name.
CRYPTOMON_IFACE=enp0s1

# --------------------------------------------------------------------------
# Database
# --------------------------------------------------------------------------
# The same database the API reads. Put the real password here; it is why this
# file is 0600.
#
# Worth giving the sensor its own MongoDB user with write-only access to the
# cryptomon collection, rather than sharing the API's credential: the two
# processes have different exposure and there is no reason a compromise of
# one should hand over the other's access.
DB_URL=mongodb://cryptomonSensor:CHANGE-ME@127.0.0.1:27017/cryptomon?retryWrites=true&w=majority
DB_NAME=cryptomon

DEBUG_MODE=false
