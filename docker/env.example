# Copy to `.env` next to compose.yaml and edit. `cp env.example .env`.
#
# Named without the leading dot on purpose: `.env` is what compose reads and
# what holds real credentials, and .dockerignore excludes every `.env` and
# `.env.*` from every build context. This file is an example and is meant to
# be committed; the one you make from it is not.

# --- the database ----------------------------------------------------------
# The default in compose.yaml is `change-me-this-is-not-a-password`. It is a
# placeholder written out in full so that nobody mistakes it for a generated
# secret. Replace it before the stack is reachable by anybody but you.
MONGO_USER=cryptomon
MONGO_PASSWORD=change-me-this-is-not-a-password
MONGO_DB=cryptomon

# Where MongoDB is published on the host. Loopback. `0.0.0.0` publishes your
# monitoring database to the network, and docker's port forwarding on Linux
# is applied before the host firewall's INPUT chain, so a firewall will not
# save you.
MONGO_BIND=127.0.0.1
MONGO_PORT=27017

# --- the API ---------------------------------------------------------------
API_BIND=127.0.0.1
API_PORT=8000

# Writes through /data are refused unless this is false.
READ_ONLY=true

# Required by the upload UI and by every mutating route when set. Set it
# before you change API_BIND to anything but 127.0.0.1: an open /analyse
# endpoint spends your CPU and your disk for whoever finds it.
API_KEY=

UPLOADS_ENABLED=true
MAX_UPLOAD_BYTES=268435456
ANALYSIS_TIMEOUT_SECONDS=120

# Reports hold the SNI of every connection in the capture. Hours; 0 keeps
# them forever.
REPORT_RETENTION_HOURS=24

# The live collection. 0 keeps everything, which is the default because
# discarding it would destroy the historical series this project exists to
# build.
DATA_RETENTION_HOURS=0

# --- the sensor (docker compose --profile sensor up) -----------------------
# The interface to watch. There is no default and compose refuses to start
# the sensor without one.
SENSOR_IFACE=
